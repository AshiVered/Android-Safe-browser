{
  "manifest_version": 2,
  "name": "Media Blocker",
  "version": "1.0",
  "description": "Blocks images and videos on all pages",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "media-blocker@safebrowser"
    }
  }
}
