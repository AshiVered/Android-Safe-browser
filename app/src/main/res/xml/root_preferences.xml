<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory app:title="@string/settigs_block">
        <SwitchPreferenceCompat
            android:key="photos"
            app:title="@string/photos_title"
            app:summaryOn="@string/block_media_on"
            app:summaryOff="@string/block_media_off" />
        <SwitchPreferenceCompat
            android:key="news"
            app:title="@string/news_title"
            app:summaryOn="@string/block_news_on"
            app:summaryOff="@string/block_news_off" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settigs_general">
        <SwitchPreferenceCompat
            android:key="URL"
            app:title="@string/url_title"
            app:summaryOn="@string/show_url_on"
            app:summaryOff="@string/show_url_off" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/security_settings">
        <SwitchPreferenceCompat
            app:key="lock_settings"
            app:title="@string/lock_settings_title"
            app:summaryOn="@string/lock_settings_summary_on"
            app:summaryOff="@string/lock_settings_summary_off" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/info">
        <Preference
            android:key="Version"
            android:title="@string/name_ver"
            android:summary="@string/app_ver"
            android:selectable="false" />
        <Preference
            android:key="Contact"
            android:title="@string/contcat"
            android:summary="@string/contact_info"
            android:selectable="false" />
    </PreferenceCategory>

</PreferenceScreen>
